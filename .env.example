# Optional: point IdentityGuard to your own private AI risk-analysis endpoint.
# The default open-source build does not require this and keeps analysis local.
VITE_IDENTITYGUARD_AI_ENDPOINT=

# Optional: document the private sync endpoint used by the SaaS edition.
# The current browser build stores this as a readiness setting only.
VITE_IDENTITYGUARD_SYNC_ENDPOINT=
